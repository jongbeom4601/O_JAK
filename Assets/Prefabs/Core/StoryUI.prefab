--- !u!114 &4370091055789361490
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 817818209475352113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bf0eb1b447b0254b83e2513f80260ad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  screenFader: {fileID: 0}
  sceneFadeIn: 0.4
  sceneFadeOut: 0.4
  firstLineDelay: 3
  dialoguePanel: {fileID: 2894484839663846291}
  nameText: {fileID: 1033963080976451580}
  dialogueText: {fileID: 8893524270707700671}
  endCursor: {fileID: 7426278591930534733}
  portraitImage: {fileID: 4868130437238466061}
  portraitFade: 0.15
  lines:
  - speakerName: "\uC9C1\uB140"
    text: "\uAC00\uB098\uB2E4\uB77C\uB9C8\uC0AC\uC544\uC790\uCC28\uD0A4\uD0C0\uD30C\uD558"
    portrait: {fileID: 21300000, guid: 0f3a8f3e25256194c9ca75e21f292810, type: 3}
    flipX: 0
  - speakerName: "\uC625\uD669\uC0C1\uC81C"
    text: "\uB0B4 \uADF8\uB9AC\uB3C4 \uACBD\uACE0\uD588\uAC70\uB298..."
    portrait: {fileID: 21300000, guid: 8618292b34e62bc4c88cef55d026f1b5, type: 3}
    flipX: 0
  - speakerName: "\uC625\uD669\uC0C1\uC81C"
    text: "\uCC9C\uACC4\uC758 \uC77C\uC740 \uD33D\uAC1C\uCE58\uACE0 \uB178\uB2E5\uAC70\uB9AC\uBA70
      \uB05D\uB0B4 \uC9D0\uC744 \uB178\uD558\uAC8C \uD558\uB294\uAD6C\uB098..."
    portrait: {fileID: 21300000, guid: fce865169d1b596458786f61cb896a9c, type: 3}
    flipX: 0
  - speakerName: "\uC625\uD669\uC0C1\uC81C"
    text: "\uD615\uBC8C\uC744 \uB0B4\uB9AC\uACA0\uB2E4.\n\uB2E4\uC2DC \uB9CC\uB098\uACE0
      \uC2F6\uAC70\uB298 \uB108\uD76C\uC758 \uB2A5\uB825\uC744 \uC99D\uBA85\uD574\uB77C."
    portrait: {fileID: 21300000, guid: 73de20e4acd3f6f49b052e438c1c2fed, type: 3}
    flipX: 0
  - speakerName: "\uACAC\uC6B0, \uC9C1\uB140"
    text: ...... / ......
    portrait: {fileID: 21300000, guid: 59c63c9d0aa5b4d488ed37aa3afe1670, type: 3}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uC9C1\uB140.. \uC9C1\uB140..! \uB4E4\uB9AC\uC2DC\uC624 \uC9C1\uB140?"
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uC9C1\uB140"
    text: "\uB4E4\uB9BD\uB2C8\uB2E4."
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uC5F0\uB77D\uC7A5\uCE58\uAC00 \uAE68\uC9C0\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC774\uAD70.."
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uC9C1\uB140"
    text: "\uADF8\uB098\uC800\uB098 \uC5EC\uAE34 \uC5B4\uB514\uC778\uAC78\uAE4C\uC694?"
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uC18C\uBB38\uC73C\uB85C \uB4E3\uB358 \uC625\uD669\uC0C1\uC81C\uC758 \uBBF8\uAD81
      \uC778\uAC83\uAC19\uAD70."
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uADF8\uC790\uB97C \uB9CC\uB098\uB7EC\uAC00\uC57C\uACA0\uC5B4."
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uC9C1\uB140"
    text: "\uD558\uC9C0\uB9CC \uC5B4\uB5BB\uAC8C \uC5EC\uAE38 \uBE60\uC838\uB098\uAC00\uC8E0?"
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uC6B0\uB9AC\uC5D0\uAC90 \uCC9C\uACC4\uC758 \uBB3C\uAC74\uC774 \uC788\uC796\uC544"
    portrait: {fileID: 0}
    flipX: 0
  - speakerName: "\uACAC\uC6B0"
    text: "\uCC9C\uACC4\uC640 \uBA40\uC5B4\uC838 \uD798\uC740 \uC57D\uD574\uC84C\uACA0\uC9C0\uB9CC,
      \uADF8\uB798\uB3C4 \uC4F8\uC218\uB294 \uC788\uC744\uAC70\uC57C."
    portrait: {fileID: 0}
    flipX: 0
  nextSceneName: 
  typeSpeed: 0.05
